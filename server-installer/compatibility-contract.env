# Canonical compatibility contract for Android deploy and standalone installer.
# Changing any value requires updating both paths; the build guard enforces it.
WDTT_DEPLOY_CONTRACT_VERSION="1"
WDTT_SERVER_VERSION="17"
WDTT_SERVER_BINARY_PATH="/usr/local/bin/wdtt-server"
WDTT_SYSTEMD_UNIT_PATH="/etc/systemd/system/wdtt.service"
WDTT_CONFIG_DIRECTORY="/etc/wdtt"
WDTT_ACCESS_DATABASE="passwords.json"
WDTT_WG_KEYS_FILE="wg-keys.dat"
WDTT_ANDROID_DEPLOY_MARKER="Managed by WDTT Plus Android deploy"
WDTT_ANDROID_CONTRACT_MARKER="WDTT deploy compatibility: 1"
